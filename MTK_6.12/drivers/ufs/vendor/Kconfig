config TRAN_UFS_ERR_RECORD_DEBUG
	bool "record_ufs_driver_except debug switch"
	default y
	depends on SCSI_UFSHCD
	help
	   THE debug switch for transsion record ufs except
config TRAN_FREEZE_DETECT_SUPPORT
	bool "tran feeze detect support"
	default y
	depends on SCSI_UFSHCD
	help
