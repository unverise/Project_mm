load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl","kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

define_mgk_ddk_ko(
    name = "tran_vtshell",
    srcs = [
        "tran_vtshell.c",
    ],
    hdrs = glob(["**/*.h", "include/*.h"]),
    includes = ["include","."],
    copts = [
        "-I$(srctree)/$(src)",
        "-I$(DEVICE_MODULES_PATH)/include/linux",
    ],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/thermal/mediatek:thermal_interface".format(kernel_version)
    ],
)

define_mgk_ddk_ko(
    name = "tran_intf",
    srcs = [
        "tran_intf.c",
    ],
    ko_deps = [
		"//kernel_device_modules-{}/drivers/power/supply/transsion:tc_common_class".format(kernel_version),
    ],
    header_deps = [
       "//kernel_device_modules-{}/drivers/power/supply/transsion:tc_charger_header".format(kernel_version),
    ],

    hdrs = glob(["**/*.h", "include/*.h"]),
    includes = ["include","."],
    copts = [
        "-I$(srctree)/$(src)",
        "-I$(DEVICE_MODULES_PATH)/include/linux",
    ],
)
