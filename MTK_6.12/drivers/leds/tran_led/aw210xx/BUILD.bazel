load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("@mgk_info//:kernel_version.bzl", "kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)

filegroup(
    name = "ddk_src",
    srcs = glob([
        "**/Makefile",
        "**/Kbuild",
        "**/*.c",
        "**/*.h",
    ]),
)

 # aw2023 LED driver module
define_mgk_ddk_ko(
    name = "leds_aw210xx",
    srcs = [
        "leds_aw210xx_main.c",
	"aw_lamp_interface.c",
	"aw_breath_algorithm.c",
    ],
    hdrs = [
    	"leds_aw210xx.h",
	"aw210xx_reg_cfg.h",
        "leds_aw210xx_reg.h",
	"aw_lamp_interface.h",
	"aw_breath_algorithm.h",
	],
    includes = [
	    ".",
	],
    ko_deps = [
        "//kernel_device_modules-{}/drivers/leds/tran_led/core:tran-led-core".format(kernel_version),
    ],

)
