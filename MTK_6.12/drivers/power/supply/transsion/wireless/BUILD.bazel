define_mgk_ddk_ko(
    name = "tc_mt5728",
    srcs = [
        "tran_mt5728.c",
        "wireless_sha1.c",
    ],
    header_deps = [
       "//kernel_device_modules-{}/drivers/power/supply/transsion:tc_charger_header".format(kernel_version),
