config MTK_RPMB
	tristate "RPMB partition interface"
	help
	  Unified RPMB partition interface for eMMC and UFS.
	  Provides interface for in kernel security controllers to
	  access RPMB partition.

	  If unsure, select N.
#USD: add [rpmb] by tie.huang 20250709 start
config TRAN_ENABLE_RPMB
    tristate "Enable tran rpmb"
    default y
    help
      enable tran rpmb
#USD: add [rpmb] by tie.huang 20250709 end
