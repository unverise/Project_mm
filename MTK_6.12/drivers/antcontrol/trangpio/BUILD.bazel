load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl", "kernel_version")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ddk_ko(
    name = "trangpio",
    srcs = [
        "trangpio.c",
    ],
    includes = ["."],
    copts = [
        "-I$(srctree)/$(src)",
        "-I$(DEVICE_MODULES_PATH)/include/linux",
        "-Wall",
        "-Werror",
    ],
    out = "trangpio.ko",
)

ddk_headers(
   name = "headers",
   hdrs = glob([
        "*.h",
   ]),
   includes = ["."],
   linux_includes = [
       "include",
   ],
)

filegroup(
    name = "srcs",
    srcs = glob([
          "**/*.c",
          "**/*.h",
    ]),
)