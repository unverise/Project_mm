config MTK_SENSORHUB
	tristate "sensorhub architecture for MediaTek package"
	help
	  It support mediatek sensorhub architecture.
	  If this option is set,
	  it will support
	  mediatek sensorhub architecture.
config MTK_SENSOR_LEGACY_SUPPORT
	tristate "sensorhub legacy support for LP"
	help
	  It support mediatek sensorhub legacy feature support.
	  If this option is set,
	  it will support
	  mediatek sensorhub legacy features.
