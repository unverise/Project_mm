load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl", "kernel_version")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ddk_ko(
    name = "tran_gpio_sar_monitor_module",
    srcs = [
        "tran_gpio_sar_monitor_module.c",
    ],
    includes = ["."],
    copts = [
        "-I$(srctree)/$(src)",
        "-I$(DEVICE_MODULES_PATH)/include/linux",
    ],
    out = "tran_gpio_sar_monitor_module.ko",
)

ddk_headers(
   name = "headers",
   hdrs = [],
   includes = ["."],
   linux_includes = [
       "include",
   ],
)

filegroup(
    name = "srcs",
    srcs = glob([
          "**/Makefile",
          "**/Kbuild",
          "**/*.c",
          "**/*.h",
    ]),
)
