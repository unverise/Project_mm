load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl", "kernel_version")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ddk_ko(
    name = "thd",
    srcs = [
        "system_monitor.c",
        "thd_main.c",
        "thd_util.c",
        "trace_hung_binder.c",
        "trace_hung_cpu.c",
        "trace_hung_task.c",
        "binder_monitor.c",
        "aegisk.c",
    ],
    hdrs = glob([
        "system_monitor.h",
        "thd_util.h",
        "trace_hung_binder.h",
        "trace_hung_cpu.h",
        "trace_hung_task.h",
        "binder_monitor.h",
        "aegisk.h",
    ]),
    includes = ["."],
    ko_deps = [
    "//kernel_device_modules-{}/drivers/misc/tranlog:transsion_tranlog".format(kernel_version),
    ],
    header_deps = [
    "//kernel_device_modules-{}/drivers/misc/tranlog:headers".format(kernel_version),
    ],
    copts = [
        "-I$(srctree)/$(src)",
        "-I$(DEVICE_MODULES_PATH)/inlcude/linux",
        "-I$(DEVICE_MODULES_PATH)/drivers/misc/transsion/include",
    ],
    out = "thd.ko",
)

ddk_headers(
   name = "headers",
   hdrs = [
        "system_monitor.h",
        "thd_util.h",
        "trace_hung_binder.h",
        "trace_hung_cpu.h",
        "trace_hung_task.h",
        "binder_monitor.h",
        "aegisk.h",
   ],
   includes = ["."],
   linux_includes = [
       "include",
   ],
)

filegroup(
    name = "srcs",
    srcs = glob([
          "**/Makefile",
          "**/Kbuild",
          "**/*.c",
          "**/*.h",
    ]),
)
