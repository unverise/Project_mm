#Fingerprint
#
menu "Fingerprint support"
	depends on INPUT
config TRAN_FINGERPRINT
	tristate "Tran Fingerprint"
	depends on DEVICE_MODULES_SPI_MT65XX
	default n
	help
	TRAN fingerprint chip.
config TRAN_FINGERPRINT_LEGACY
	tristate "Tran Fingerprint"
	depends on DEVICE_MODULES_SPI_MT65XX
	default n
	help
	TRAN legacy fingerprint chip.
config MTK_FINGERPRINT_SUPPORT
	tristate "Mediatek Fingerprint"
	default n
	help
	  Fingerprint mtk driver enable/disable
	  in the kernel.Say Y here if you want to
	  use mediatek fingerprint driver,fingerprint
	  driver will support fingerprint function

endmenu
source "$(KCONFIG_EXT_PREFIX)/drivers/input/fingerprint/tran_common_v2/Kconfig"
source "$(KCONFIG_EXT_PREFIX)/drivers/input/fingerprint/tran_common/Kconfig"
