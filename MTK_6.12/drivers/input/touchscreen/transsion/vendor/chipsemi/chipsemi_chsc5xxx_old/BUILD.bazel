load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl","kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
	name = "srcs",
	srcs = glob([
		"**/*.c",
	]),
)

define_mgk_ddk_ko(
    name = "chipsemi_chsc5xxx_old",
    srcs = [
        "chipsemi_transsion.c",
        "basic_util.c",
        "spi_communication.c",
        "semi_touch_function.c",
        "semi_touch_upgrade.c",
        "semi_touch_apk.c",
        "semi_touch_device.c",
        "semi_touch_custom.c",
        "semi_touch_test_5xxx.c",
        "semi_touch_thp_dev.c",
        "qual_core.c",
    ],
    hdrs = glob(["**/*.h"]),
    includes = ["include"],
    copts = [
        "-Wall",
        "-Werror",
        "-I$(DEVICE_MODULES_PATH)/drivers/input/touchscreen/transsion/core/include/",
    ],
    header_deps  = [
	"//kernel_device_modules-{}/drivers/input/touchscreen/transsion/core:tp_core_header".format(kernel_version),
    ],
    ko_deps = [
	"//kernel_device_modules-{}/drivers/input/touchscreen/transsion/core:adaptive-ts".format(kernel_version),
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)
