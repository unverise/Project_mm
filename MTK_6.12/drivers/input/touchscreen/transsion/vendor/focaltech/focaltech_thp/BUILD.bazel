load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")
load("@mgk_info//:kernel_version.bzl","kernel_version",)

package(
    default_visibility = [
        "//visibility:public",
    ],
)

filegroup(
	name = "srcs",
	srcs = glob([
		"**/*.c",
	]),
)

define_mgk_ddk_ko(
    name = "focaltech_thp",
    srcs = [
        ":srcs",
    ],
    hdrs = glob(["**/*.h","**/*.i"]),
    includes = ["include"],
    copts = [
        "-Wall",
        "-Werror",
        "-I$(DEVICE_MODULES_PATH)/drivers/input/touchscreen/transsion/core/include/",
        "-I$(DEVICE_MODULES_PATH)/drivers/input/touchscreen/transsion/vendor/focaltech/focaltech_thp/firmware/include/",
        "-I$(DEVICE_MODULES_PATH)/drivers/misc/tranlog/",
    ],
    header_deps  = [
	"//kernel_device_modules-{}/drivers/input/touchscreen/transsion/core:tp_core_header".format(kernel_version),
    ],
    ko_deps = [
	"//kernel_device_modules-{}/drivers/input/touchscreen/transsion/core:adaptive-ts".format(kernel_version),
    "//kernel_device_modules-{}/drivers/misc/tranlog:transsion_tranlog".format(kernel_version),
    ],
)

filegroup(
    name = "ddk_kconfigs",
    srcs = glob([
        "**/Kconfig",
    ]),
)
