# Virtualization android guest support drivers
#

config HYPER_VM_UOS
	tristate "hypervisor guest android1 os"
	help
	  The hypervisor project is "m".
	  Used for hypervisor guest android1 os.
	  If your code is for hypervisor android os,
	  you can use it to wrap your code.

config VIRTIO_VIDEO_MTK_EXTENSION
	tristate "MTK extensions"
	help
	  This option enables support for MediaTek-specific extensions
	  to the virtio video driver.
	  This is the virtual video driver for virtio.
	  Say Y or M.

config VIRTIO_VIDEO_TRACE_DEBUG
	bool "VIRTIO Video TRACE Debug support"
	depends on VIRTIO_VIDEO_MTK_EXTENSION
	help
	  This is a debug interface for VIRTIO Video
	  Set Y to enable this feature.
	  Set N to disable this feature.
	  If unsure, Set N to disable it.

config DEVICE_MODULES_VIRTIO_VDMABUF
	tristate "DMA-BUF vdmabuf"
	depends on HYPER_VM_UOS
	help
	  Choose this option to enable  vdmabuf feature.
	  vdmabuf is a means of cross-domain shared memory. Its function is
	  to transfer the dmabuf requested by the guest to the host so that
	  both ends can access the same physical mem. This is the
	  configuration of vdmabuf on the guest side.

config VIRTIO_MTK_MMDVFS
	tristate "MediaTek Virtio MMDVFS Support"
	help
	  Say yes here to add support for the MediaTek Multimedia DVFS (MMDVFS)
	  driver in Hypervisor guest OS. The MMDVFS is used to set clk for Mediatek Multimedia hardwares
	  , such as display, camera, mdp and video codec. Say no if your device
	  does not need to do DVFS for Multimedia hardwares.
