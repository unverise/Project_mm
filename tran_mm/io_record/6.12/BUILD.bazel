load("//build/bazel_mgk_rules:mgk_ddk_ko.bzl", "define_mgk_ddk_ko")
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers")

package(
    default_visibility = [
        "//visibility:public",
    ],
)

define_mgk_ddk_ko(
    name = "io_record",
    srcs = [
        "io_record.c",
    ],
    hdrs = glob([
	"**/*.h",
    ]),
    includes = ["."],
    copts = [
        "-I$(srctree)/include",
        "-I$(srctree)/include/linux",
        "-I$(srctree)",
        "-I$(srctree)/$(src)",
    ],
    out = "io_record.ko",
)
